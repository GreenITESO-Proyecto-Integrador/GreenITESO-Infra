# Copy to terraform.tfvars (gitignored). Never put secret values here: the
# Django secret key and database URL go into Secret Manager (see README).

project_id     = "REPLACE-with-gcp-project-id"
project_number = "REPLACE-with-gcp-project-number" # gcloud projects describe <id> --format='value(projectNumber)'
region         = "northamerica-south1"
environment    = "production" # dev | staging | production
app_name       = "greeniteso"

# Fill in after the first targeted apply creates the registry (see README).
backend_image  = "northamerica-south1-docker.pkg.dev/REPLACE-project/greeniteso/backend@sha256:REPLACE"
frontend_image = "northamerica-south1-docker.pkg.dev/REPLACE-project/greeniteso/frontend@sha256:REPLACE"

microsoft_client_id = "REPLACE-with-entra-client-id"

# Null = use the run.app URLs and skip the load balancer entirely.
domain = null

monitoring_notification_email = null

labels = {
  project = "greeniteso"
  env     = "production"
}
