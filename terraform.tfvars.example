# Copy to terraform.tfvars (gitignored) and fill in once a GCP project
# is available. No verified project ID or image is configured here — do not
# invent one.

project_id      = "REPLACE-with-real-gcp-project-id"
region          = "northamerica-south1"
environment     = "dev" # dev | staging | production
app_name        = "greeniteso"
container_image = "REPLACE-region-docker.pkg.dev/REPLACE-project/REPLACE-repo/greeniteso:latest"

# Leave null until a domain is owned and DNS is delegated to this project.
domain = null

# Keep null: this Cloud Build/Cloud Deploy scaffold has no migration gate and
# must not create a second application release path yet.
github_repository             = null
github_trigger_enabled        = false
monitoring_notification_email = null

labels = {
  project = "greeniteso"
  env     = "dev"
}
